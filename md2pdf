#!/usr/bin/env bash
#
# md2pdf — Convert Markdown files to PDF using headless Chromium (via md-to-pdf).
#           Renders Mermaid diagrams (via mmdc) and PlantUML diagrams (via public server).
#           GitHub-flavored rendering, no dialogs, no browser windows.
#
# Usage:
#   md2pdf file.md                     # → file.pdf (same directory)
#   md2pdf file.md -o ~/Desktop        # → ~/Desktop/file.pdf
#   md2pdf *.md                        # batch convert
#   md2pdf *.md -o ./pdfs              # batch to a folder
#   md2pdf file.md --dark              # dark theme
#   md2pdf file.md --present           # 16:9 slide deck, one slide per H2
#   md2pdf file.md --open              # open PDF after conversion (macOS)

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────────
OUTPUT_DIR=""
THEME="light"
OPEN_AFTER=false
PRESENT=false
FILES=()

# ── Parse args ────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    --dark)
      THEME="dark"
      shift
      ;;
    --present|--presentation)
      PRESENT=true
      shift
      ;;
    --open)
      OPEN_AFTER=true
      shift
      ;;
    -h|--help)
      cat <<'HELP'

  md2pdf — Convert Markdown to PDF (headless Chromium, no dialogs)

  Renders Mermaid and PlantUML diagrams inline as SVG images.

  Usage:
    md2pdf <file.md> [file2.md ...] [options]

  Options:
    -o, --output <dir>   Output directory (default: same as input file)
    --dark               Dark theme (dark background, light text)
    --present            Slide deck: 16:9 landscape, larger type, one slide per H2
    --open               Open the PDF after conversion (macOS)
    -h, --help           Show this help

  Examples:
    md2pdf README.md
    md2pdf docs/*.md -o ~/Desktop
    md2pdf INTERVIEW-PREP.md --dark --open
    md2pdf process-and-gaps.md --present

  Requires:
    md-to-pdf   — npm install -g md-to-pdf
    mmdc        — npm install -g @mermaid-js/mermaid-cli  (for Mermaid diagrams)
    curl        — (built-in on macOS, for PlantUML via public server)

HELP
      exit 0
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      exit 1
      ;;
    *)
      FILES+=("$1")
      shift
      ;;
  esac
done

if [[ ${#FILES[@]} -eq 0 ]]; then
  echo "Error: No input files specified. Use -h for help." >&2
  exit 1
fi

# ── Check dependencies ────────────────────────────────────────────────────────
if ! command -v md-to-pdf &>/dev/null; then
  echo "Error: md-to-pdf not found. Install with: npm install -g md-to-pdf" >&2
  exit 1
fi

HAS_MMDC=false
if command -v mmdc &>/dev/null; then
  HAS_MMDC=true
fi

HAS_CURL=false
if command -v curl &>/dev/null; then
  HAS_CURL=true
fi

