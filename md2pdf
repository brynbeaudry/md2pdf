# ── Mermaid config ────────────────────────────────────────────────────────────
# Writes a mermaid CLI config. Optional 2nd arg is the base fontSize in px
# (default 14). Smaller values produce more compact diagrams — used for
# predictive sizing of large diagrams that would otherwise span pages.
create_mermaid_config() {
  local config_file="$1"
  local fontsize="${2:-14}"
  # Mermaid wraps node labels at ~200px by default, which breaks a short phrase
  # mid-clause. A slide is wide enough to let a label run, so raise the bound
  # there and let the author's own <br/> decide where lines end.
  local wrap=200; [[ "$PRESENT" == true ]] && wrap=340
  local seq_actor_fs=$((fontsize + 0))
  local seq_msg_fs=$((fontsize - 1)); (( seq_msg_fs < 9 )) && seq_msg_fs=9
  cat > "$config_file" << ENDJSON
{
  "theme": "$MERMAID_THEME",
  "themeVariables": {
    "fontSize": "${fontsize}px",
    "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif"
  },
  "flowchart":    { "useMaxWidth": true, "curve": "basis", "wrappingWidth": ${wrap} },
  "sequence":     { "useMaxWidth": true, "mirrorActors": false,
                    "actorFontSize": ${seq_actor_fs}, "messageFontSize": ${seq_msg_fs},
                    "noteFontSize": ${seq_msg_fs} },
  "gantt":        { "useMaxWidth": true },
  "block":        { "useMaxWidth": true },
  "pie":          { "useMaxWidth": true },
  "stateDiagram": { "useMaxWidth": true }
}
ENDJSON
}

# ── Predict an appropriate mermaid fontSize from block content ────────────────
# Counts arrows / messages / states per diagram type. Heuristic only: returns
# 14 (default) for small diagrams, 12 for medium, 10 for large. Combined with
# the CSS max-height clamp this keeps any diagram on a single A4 page while
# remaining legible.
predict_mermaid_fontsize() {
  local content="$1"
  local kind
  kind=$(echo "$content" | grep -oE 'sequenceDiagram|stateDiagram(-v2)?|flowchart|graph|classDiagram|erDiagram|gantt|pie|journey|timeline' 2>/dev/null | head -1 || true)
  local non_empty
  non_empty=$(echo "$content" | grep -cE '^[[:space:]]*[^[:space:]%]' || true)

  local fs=14
  case "$kind" in
    sequenceDiagram)
      local msgs
      msgs=$(echo "$content" | grep -cE '\-?\->>?' || true)
      if   (( msgs > 18 )); then fs=10
      elif (( msgs > 10 )); then fs=12
      fi ;;
    flowchart|graph)
      local arrows
      arrows=$(echo "$content" | grep -cE '\-\->|==>|\.\.>' || true)
      if   (( arrows > 22 )); then fs=10
      elif (( arrows > 12 )); then fs=12
      fi ;;
    stateDiagram|stateDiagram-v2)
      if   (( non_empty > 28 )); then fs=10
      elif (( non_empty > 16 )); then fs=12
      fi ;;
    *)
      if   (( non_empty > 36 )); then fs=10
      elif (( non_empty > 22 )); then fs=12
      fi ;;
  esac
  echo "$fs"
}

# ── Strip inline Mermaid theme directives so our config wins ──────────────────
sanitize_mermaid_source() {
  local content="$1"
  # Remove %%{init: {...}}%% lines that set theme, so --configFile controls it
  echo "$content" | sed -E '/^%%\{init:.*\}%%$/d'
}

# ── Render a single Mermaid block to SVG ──────────────────────────────────────
# Captures stderr to a per-diagram log so failures can be reported to the user
# instead of silently falling back to a code block. Returns 0 on success.
render_mermaid() {
  local mmd_file="$1"
  local svg_file="$2"
  local config_file="$3"
  local err_file="${mmd_file%.mmd}.err"

  mmdc -i "$mmd_file" -o "$svg_file" -c "$config_file" -b transparent -w 1600 --quiet 2>"$err_file"
}

# ── Render a single PlantUML block to SVG via public server ───────────────────
render_plantuml() {
  local puml_content="$1"
  local svg_file="$2"

  # Encode for PlantUML server using deflate + base64-like encoding
  # Simpler approach: use the ~h (hex) encoding
  local encoded
  encoded=$(printf '%s' "$puml_content" | python3 -c "
import sys, zlib, base64
data = sys.stdin.buffer.read()
compressed = zlib.compress(data, 9)
# PlantUML uses a custom base64 with 0-9A-Za-z-_ mapping
def encode64(data):
    res = ''
    mapping = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_'
    for i in range(0, len(data), 3):
        b1 = data[i]
        b2 = data[i+1] if i+1 < len(data) else 0
        b3 = data[i+2] if i+2 < len(data) else 0
        res += mapping[b1 >> 2]
        res += mapping[((b1 & 0x3) << 4) | (b2 >> 4)]
        res += mapping[((b2 & 0xF) << 2) | (b3 >> 6)]
        res += mapping[b3 & 0x3F]
    return res
print(encode64(compressed))
" 2>/dev/null)

  if [[ -n "$encoded" ]]; then
    curl -sf "https://www.plantuml.com/plantuml/svg/$encoded" -o "$svg_file" 2>/dev/null
  fi
}

# ── Pre-process: inject a Table of Contents and explicit HTML anchors ───────
# - Scans the markdown for H2 and H3 headings (skipping anything inside fenced
#   code blocks).
# - Prepends an explicit <a id="slug"></a> before each heading so TOC links
#   work regardless of how the markdown renderer slugifies headings.
# - Inserts a contents block immediately after the first H1. Arguments 3-5 are
#   emit ('false' for anchors only), the heading to use, and an optional wrapper
#   class so presentation mode can style its agenda card differently.
# - Skips injection entirely if the doc has fewer than 3 headings.
inject_toc() {
  local input_file="$1"
  local output_file="$2"
  local emit_toc="${3:-true}"
  local toc_heading="${4:-Table of Contents}"
  local toc_wrap="${5:-}"

  # Stage 1: build the TOC body (markdown list) into a temp file.
  local toc_tmp
  toc_tmp="$(mktemp)"
  awk '
    BEGIN { in_code = 0 }
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^## / {
      text = substr($0, 4)
      print "- [" text "](#" slugify(text) ")"
    }
    /^### / {
      text = substr($0, 5)
      print "  - [" text "](#" slugify(text) ")"
    }
    function slugify(s,    out) {
      out = tolower(s)
      gsub(/<[^>]+>/, "", out)        # strip HTML tags
      gsub(/[^a-z0-9 -]/, "", out)    # strip punctuation
      gsub(/[ \t]+/, "-", out)        # spaces to hyphens
      gsub(/-+/, "-", out)            # collapse repeats
      sub(/^-+/, "", out)             # trim leading
      sub(/-+$/, "", out)             # trim trailing
      return out
    }
  ' "$input_file" > "$toc_tmp"

  local toc_lines
  toc_lines=$(wc -l < "$toc_tmp" | tr -d ' ')

  # Bail out if there aren't enough headings to warrant a TOC.
  if [[ "$toc_lines" -lt 3 ]]; then
    cp "$input_file" "$output_file"
    rm -f "$toc_tmp"
    return 0
  fi

  # Stage 2: emit the file with anchors and the TOC block injected after H1.
  awk -v toc_file="$toc_tmp" -v emit_toc="$emit_toc" \
      -v toc_heading="$toc_heading" -v toc_wrap="$toc_wrap" '
    BEGIN {
      in_code = 0
      h1_done = 0
      toc_done = 0
      while ((getline line < toc_file) > 0) {
        toc_body = toc_body line "\n"
      }
      close(toc_file)
    }
    /^```/ { in_code = !in_code; print; next }
    in_code { print; next }
    /^# / && !h1_done {
      print
      h1_done = 1
      next
    }
    /^## / {
      # Emitted before the first real section, not straight after the H1, so the
      # H1 keeps its framing paragraph — which is the whole title card in a deck.
      if (emit_toc == "true" && h1_done && !toc_done) {
        print ""
        print "## " toc_heading
        print ""
        if (toc_wrap != "") { print "<div class=\"" toc_wrap "\">"; print "" }
        printf "%s", toc_body
        if (toc_wrap != "") { print ""; print "</div>" }
        print ""
        toc_done = 1
      }
      text = substr($0, 4)
      print "<a id=\"" slugify(text) "\"></a>"
      print
      next
    }
    /^### / {
      text = substr($0, 5)
      print "<a id=\"" slugify(text) "\"></a>"
      print
      next
    }
    { print }
    function slugify(s,    out) {
      out = tolower(s)
      gsub(/<[^>]+>/, "", out)
      gsub(/[^a-z0-9 -]/, "", out)
      gsub(/[ \t]+/, "-", out)
      gsub(/-+/, "-", out)
      sub(/^-+/, "", out)
      sub(/-+$/, "", out)
      return out
    }
  ' "$input_file" > "$output_file"

  rm -f "$toc_tmp"
}

# ── Pre-process: extract diagram blocks, render, replace with <img> ───────────
preprocess_diagrams() {
  local input_file="$1"
  local output_file="$2"
  local work_dir="$3"

  local diagram_count=0
  local in_block=false
  local block_type=""
  local block_content=""
  local line

  # Process line by line
  while IFS= read -r line || [[ -n "$line" ]]; do

    # Detect start of mermaid block
    if [[ "$in_block" == false ]] && [[ "$line" =~ ^\`\`\`mermaid ]]; then
      in_block=true
      block_type="mermaid"
      block_content=""
      continue
    fi

    # Detect start of plantuml block
    if [[ "$in_block" == false ]] && [[ "$line" =~ ^\`\`\`plantuml ]] || [[ "$line" =~ ^\`\`\`puml ]] || [[ "$line" =~ ^\`\`\`uml ]]; then
      in_block=true
      block_type="plantuml"
      block_content=""
      continue
    fi

    # Detect end of block
    if [[ "$in_block" == true ]] && [[ "$line" =~ ^\`\`\` ]]; then
      in_block=false
      ((diagram_count++)) || true

      local svg_file="$work_dir/diagram-${diagram_count}.svg"

      if [[ "$block_type" == "mermaid" ]] && [[ "$HAS_MMDC" == true ]]; then
        local mmd_file="$work_dir/diagram-${diagram_count}.mmd"
        sanitize_mermaid_source "$block_content" > "$mmd_file"
        # Predict a content-appropriate fontSize so large diagrams stay on one
        # page after the CSS max-height clamp. Writes a per-diagram config.
        local fs
        fs=$(predict_mermaid_fontsize "$block_content")
        # The prediction targets an A4 page. A slide is wider and shorter, so the
        # diagram is scaled down harder and the same font lands unreadable from a
        # room. Scale the label size up to compensate.
        if [[ "$PRESENT" == true ]]; then fs=$(( fs * 8 / 5 )); fi
        local diagram_config="$work_dir/mermaid-config-${diagram_count}.json"
        create_mermaid_config "$diagram_config" "$fs"
        if render_mermaid "$mmd_file" "$svg_file" "$diagram_config" && [[ -f "$svg_file" ]] && [[ -s "$svg_file" ]]; then
          local b64
          b64=$(base64 < "$svg_file" | tr -d '\n')
          echo "<div class=\"diagram-container\"><img src=\"data:image/svg+xml;base64,${b64}\" alt=\"Mermaid diagram\"></div>"
        else
          # Surface the mermaid error loudly. Print to stderr (so it shows in
          # md2pdf's terminal output) and also embed a visible warning block
          # in the PDF so the failure isn't disguised as a code listing.
          local err_first
          err_first=$(grep -m1 -E 'Error:|Parse error|Lexical error' "${mmd_file%.mmd}.err" 2>/dev/null || echo "mmdc failed (no error captured)")
          echo "  ⚠ diagram $diagram_count FAILED: $err_first" >&2
          echo "<div class=\"diagram-container\" style=\"border-color:#f8d7da;background:#fdf2f2;\">" \
               "<strong style=\"color:#842029;\">⚠ Mermaid diagram $diagram_count failed to render</strong><br>" \
               "<code style=\"color:#842029;\">$(echo "$err_first" | sed 's/[<>&]//g' | head -c 200)</code></div>"
          echo '```mermaid'
          echo "$block_content"
          echo '```'
        fi

      elif [[ "$block_type" == "plantuml" ]] && [[ "$HAS_CURL" == true ]]; then
        if render_plantuml "$block_content" "$svg_file" && [[ -f "$svg_file" ]] && [[ -s "$svg_file" ]]; then
          local b64
          b64=$(base64 < "$svg_file" | tr -d '\n')
          echo "<div class=\"diagram-container\"><img src=\"data:image/svg+xml;base64,${b64}\" alt=\"PlantUML diagram\"></div>"
        else
          echo '```'
          echo "$block_content"
          echo '```'
          echo "<!-- plantuml render failed for diagram $diagram_count -->"
        fi

      else
        # No renderer available — keep as code block
        echo "\`\`\`${block_type}"
        echo "$block_content"
        echo '```'
      fi

      block_type=""
      block_content=""
      continue
    fi

    # Accumulate block content
    if [[ "$in_block" == true ]]; then
      if [[ -n "$block_content" ]]; then
        block_content="${block_content}
${line}"
      else
        block_content="$line"
      fi
      continue
    fi

    # Regular line — pass through
    echo "$line"

  done < "$input_file" > "$output_file"

  echo "$diagram_count"
}

# ── Write CSS to temp file ────────────────────────────────────────────────────
WORK_ROOT="$(mktemp -d /tmp/md2pdf-XXXXXX)"
CSS_FILE="$WORK_ROOT/style.css"
echo "$CSS" > "$CSS_FILE"
trap 'rm -rf "$WORK_ROOT"' EXIT

# ── Create output dir if needed ───────────────────────────────────────────────
if [[ -n "$OUTPUT_DIR" ]]; then
  mkdir -p "$OUTPUT_DIR"
fi

# ── Convert each file ────────────────────────────────────────────────────────
CONVERTED=0
FAILED=0

for FILE in "${FILES[@]}"; do
  # Resolve to absolute path
  FILE="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"

  if [[ ! -f "$FILE" ]]; then
    echo "  ⚠ Skipping (not found): $FILE" >&2
    ((FAILED++)) || true
    continue
  fi

  INPUT_DIR="$(dirname "$FILE")"
  BASENAME="$(basename "${FILE%.md}")"

  if [[ -n "$OUTPUT_DIR" ]]; then
    FINAL_PDF="$(cd "$OUTPUT_DIR" && pwd)/$BASENAME.pdf"
  else
    FINAL_PDF="$INPUT_DIR/$BASENAME.pdf"
  fi

  echo "  Converting: $(basename "$FILE")"

  # ── Pre-process diagrams ────────────────────────────────────────────────
  FILE_WORK="$WORK_ROOT/$BASENAME"
  mkdir -p "$FILE_WORK"

  # Create mermaid config
  create_mermaid_config "$FILE_WORK/mermaid-config.json"

  # Inject a Table of Contents first (no-op if the doc has < 3 headings).
  # We do this BEFORE diagram preprocessing so the diagram pass still sees
  # the raw ```mermaid blocks unchanged.
  TOCIFIED_MD="$FILE_WORK/with_toc.md"
  if [[ "$PRESENT" == true ]]; then
    # A deck opens title card, then an overview card. If the author wrote their
    # own overview section we use theirs and inject nothing — the generated card
    # is the fallback for when that formatting is absent, not an override.
    if grep -qiE '^## +(overview|agenda|contents|in this deck|on the agenda|what.s covered|how to read)' "$FILE"; then
      inject_toc "$FILE" "$TOCIFIED_MD" false
    else
      inject_toc "$FILE" "$TOCIFIED_MD" true "Overview" "agenda"
    fi
  else
    inject_toc "$FILE" "$TOCIFIED_MD"
  fi

  # Check if file has any diagram blocks
  MERMAID_COUNT=$(grep -c '```mermaid' "$TOCIFIED_MD" 2>/dev/null || true)
  PLANTUML_COUNT=$(grep -cE '```(plantuml|puml|uml)' "$TOCIFIED_MD" 2>/dev/null || true)
  TOTAL_DIAGRAMS=$((MERMAID_COUNT + PLANTUML_COUNT))

  if [[ $TOTAL_DIAGRAMS -gt 0 ]]; then
    echo "  ⎿ Rendering $TOTAL_DIAGRAMS diagram(s)..."

    PROCESSED_MD="$FILE_WORK/processed.md"
    preprocess_diagrams "$TOCIFIED_MD" "$PROCESSED_MD" "$FILE_WORK"
    CONVERT_SOURCE="$PROCESSED_MD"
  else
    CONVERT_SOURCE="$TOCIFIED_MD"
  fi

  # ── Run md-to-pdf ───────────────────────────────────────────────────────
  # md-to-pdf writes the PDF next to the source file
  SOURCE_DIR="$(dirname "$CONVERT_SOURCE")"
  SOURCE_BASE="$(basename "${CONVERT_SOURCE%.md}")"
  DEFAULT_PDF="$SOURCE_DIR/$SOURCE_BASE.pdf"

  if md-to-pdf "$CONVERT_SOURCE" \
    --basedir "$FILE_WORK" \
    --stylesheet "$CSS_FILE" \
    --highlight-style github \
    --pdf-options "$PDF_OPTIONS" \
    2>/dev/null; then

    # Move to final destination
    if [[ -f "$DEFAULT_PDF" ]]; then
      if [[ "$DEFAULT_PDF" != "$FINAL_PDF" ]]; then
        mv "$DEFAULT_PDF" "$FINAL_PDF"
      fi

      SIZE=$(du -h "$FINAL_PDF" | cut -f1 | xargs)
      echo "  ✓ $FINAL_PDF ($SIZE)"
      ((CONVERTED++)) || true

      if [[ "$OPEN_AFTER" == true ]]; then
        open "$FINAL_PDF" 2>/dev/null || true
      fi
    else
      echo "  ✗ Failed (no output): $(basename "$FILE")" >&2
      ((FAILED++)) || true
    fi
  else
    echo "  ✗ Failed: $(basename "$FILE")" >&2
    ((FAILED++)) || true
  fi
done

echo ""
echo "  Done: $CONVERTED converted, $FAILED failed."
